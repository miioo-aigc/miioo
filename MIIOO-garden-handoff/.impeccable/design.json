  "narrative": {
    "northStar": "黑色留白中的摄影花园",
    "overview": "视觉方向由用户指定的 Neuralyn 参考与保留 MIIOO 品牌的确认锁定。大面积纯黑承托白色标题，植物与薄雾提供深度，界面保持克制；本文件记录已实现系统，不引入新的视觉方向。",
    "keyCharacteristics": [
      "摄影感植物包围中央空间。",
      "无衬线主标题与单个衬线斜体强调。",
      "淡彩入口、低对比玻璃工作台。",
      "可见的花茎弯曲、叶片翻动与少量叶瓣飞舞，并保留暂停控制。"
    ],
    "rules": [],
    "dos": [
      "Do 保留大面积黑色留白和清晰的标题层级。",
      "Do 让静态回退与动态场景共享同一素材和构图。",
      "Do 让演示内容、真实站点入口与本地功能边界可辨认。"
    ],
    "donts": [
      "Don't 用更多高精度三维几何替代摄影质感。",
      "Don't 增加未经证实的客户、指标或评价。",
      "Don't 宣称重建素材与参考原站像素完全一致。"
